{
  "name": "mcp-emails-free",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, single-user email MCP server (iCloud, IMAP/SMTP webmail) on Next.js + Supabase + Vercel",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "gen-key": "node scripts/gen-key.mjs",
    "create-owner": "node --env-file=.env.local scripts/create-owner.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "imapflow": "2.10.0",
    "mailparser": "3.14.1",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
