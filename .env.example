# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Email of the first admin. Created by `npm run create-owner`; more people are added in the app's Team page.
OWNER_EMAIL=you@example.com
# Only used by `npm run create-owner` (min 12 chars). Remove it afterwards.
OWNER_PASSWORD=

# 32 random bytes, base64. Generate with: npm run gen-key
# Mailbox passwords are encrypted with a key derived from this, per user. Losing it means re-adding inboxes.
ENCRYPTION_KEY=

# Public URL of the deployed app (OAuth issuer / MCP resource URL). Use http://localhost:3000 locally.
APP_URL=http://localhost:3000

# Protects /api/cron/dispatch (scheduled sends). Any long random string.
CRON_SECRET=

# Optional: inboxes allowed per person (default 5)
# MAX_INBOXES_PER_USER=5
